msgid "Action"
msgstr "ການດຳເນີນການ"

msgid "Backup"
msgstr "ສຳຮອງຂໍ້ມູນ"

msgid "Date & Time"
msgstr "ວັນທີ ແລະ ເວລາ"

msgid "Edit scheduled backup."
msgstr "ແກ້ໄຂການສຳຮອງຂໍ້ມູນແບບກຳນົດເວລາ."

msgid "Extra options"
msgstr "ຕົວເລືອກເພີ່ມເຕີມ"

msgid "Fix cron"
msgstr "ແກ້ໄຂ cron"

msgid "Fixing cron task if deleted ..."
msgstr "ກຳລັງແກ້ໄຂງານ cron ຖ້າຫາກຖືກລຶບ..."

msgid ""
"For advanced users only - Do not use unless exact root device is known."
msgstr "ສຳລັບຜູ້ໃຊ້ລະດັບສູງເທົ່ານັ້ນ - ຫ້າມໃຊ້ ຍົກເວັ້ນແຕ່ຈະຮູ້ຈັກອຸປະກອນຮາກ (root device) ທີ່ແນ່ນອນ."

msgid "Keep"
msgstr "ເກັບຮັກສາ"

msgid ""
"Keep X days of backups.  Uses Linux find mtime command to determine if "
"backup is older than X days."
msgstr "ເກັບຮັກສາການສຳຮອງຂໍ້ມູນໄວ້ X ມື້. ໃຊ້ຄຳສັ່ງ find mtime ຂອງ Linux ເພື່ອກວດສອບວ່າການສຳຮອງຂໍ້ມູນນັ້ນເກົ່າກວ່າ X ມື້ ຫຼື ບໍ່."

msgid "Message"
msgstr "ຂໍ້ຄວາມ"

msgid "Method"
msgstr "ວິທີການ"

msgid "Password"
msgstr "ລະຫັດຜ່ານ"

msgid "Root device"
msgstr "ອຸປະກອນຮາກ (Root device)"

msgid "Schedule"
msgstr "ກຳນົດເວລາ"

msgid "Scheduled Backup"
msgstr "ການສຳຮອງຂໍ້ມູນແບບກຳນົດເວລາ"

msgid "Settings"
msgstr "ການຕັ້ງຄ່າ"

msgid "Shared folder"
msgstr "ໂຟນເດີທີ່ໃຊ້ຮ່ວມກັນ"

msgid "Show more output when checked."
msgstr "ສະແດງລາຍລະອຽດການເຮັດວຽກເພີ່ມເຕີມເມື່ອເລືອກ."

msgid "Starting backup ..."
msgstr "ກຳລັງເລີ່ມການສຳຮອງຂໍ້ມູນ..."

msgid "The field should only contain * or a comma separated list of values."
msgstr "ຊ່ອງນີ້ຄວນມີພຽງເຄື່ອງໝາຍ * ຫຼື ລາຍການຄ່າທີ່ຂັ້ນດ້ວຍຈຸດ."

msgid "The location of the backup files."
msgstr "ສະຖານທີ່ເກັບໄຟລ໌ສຳຮອງຂໍ້ມູນ."

msgid ""
"To exclude addition directories, add --exclude= before each directory and "
"separate additional entries with a space. Example<br />--exclude=/pool "
"--exclude=/test<br />Warning!!  You can break the backup with wrong options."
msgstr "ເພື່ອຍົກເວັ້ນໄດເຣັກທໍຣີເພີ່ມເຕີມ, ໃຫ້ຕື່ມ --exclude= ໄວ້ທາງໜ້າແຕ່ລະໄດເຣັກທໍຣີ ແລະ ຂັ້ນແຕ່ລະລາຍການດ້ວຍຍະຫວ່າງ. ຕົວຢ່າງ<br />--exclude=/pool --exclude=/test<br />ຄຳເຕືອນ!! ເຈົ້າສາມາດເຮັດໃຫ້ການສຳຮອງຂໍ້ມູນຜິດພາດໄດ້ຫາກເລືອກຕົວເລືອກທີ່ບໍ່ຖືກຕ້ອງ."

msgid "Updated backup settings."
msgstr "ອັບເດດການຕັ້ງຄ່າການສຳຮອງຂໍ້ມູນແລ້ວ."

msgid "Verbose output"
msgstr "ສະແດງລາຍລະອຽດການເຮັດວຽກ (Verbose)"

msgid "borgbackup"
msgstr "borgbackup"

msgid "dd"
msgstr "dd"

msgid ""
"dd - use dd to clone the OS partition to a compressed image file.<br />dd "
"full disk - use dd to clone the entire drive to a compressed image file.<br "
"/>fsarchiver - use fsarchiver to clone the OS partition to an archive "
"file<br />borgbackup - use borgbackup to backup system to an archive file<br"
" />rsync - use rsync to sync files to destination directory"
msgstr "dd - ໃຊ້ dd ເພື່ອໂຄລນພາທິຊັນ OS ໄວ້ໃນໄຟລ໌ອິເມຈທີ່ຖືກບີບອັດ.<br />dd full disk - ໃຊ້ dd ເພື່ອໂຄລນດິດທັງໝົດໄວ້ໃນໄຟລ໌ອິເມຈທີ່ຖືກບີບອັດ.<br />fsarchiver - ໃຊ້ fsarchiver ເພື່ອໂຄລນພາທິຊັນ OS ໄວ້ໃນໄຟລ໌ຈັດເກັບ<br />borgbackup - ໃຊ້ borgbackup ເພື່ອສຳຮອງຂໍ້ມູນລະບົບໄວ້ໃນໄຟລ໌ຈັດເກັບ<br />rsync - ໃຊ້ rsync ເພື່ອຊິງຄ໌ໄຟລ໌ໄປຍັງໄດເຣັກທໍຣີປາຍທາງ"

msgid "dd full disk"
msgstr "dd ທັງໝົດດິດ"

msgid "fsarchiver"
msgstr "fsarchiver"

msgid "rsync"
msgstr "rsync"
