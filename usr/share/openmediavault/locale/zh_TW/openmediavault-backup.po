msgid "Action"
msgstr "動作"

msgid "Backup"
msgstr "備份"

msgid "Date & Time"
msgstr "日期和時間"

msgid "Edit scheduled backup."
msgstr "編輯預定備份工作。"

msgid "Extra options"
msgstr "額外選項"

msgid "Fix cron"
msgstr "修復 cron"

msgid "Fixing cron task if deleted ..."
msgstr "如果 cron 工作被刪除，則將它修復 ..."

msgid ""
"For advanced users only - Do not use unless exact root device is known."
msgstr "只給進階用户使用 - 除非知道確實的根裝置，否則不要使用它。"

msgid "Keep"
msgstr "保留"

msgid ""
"Keep X days of backups.  Uses Linux find mtime command to determine if "
"backup is older than X days."
msgstr "保留 X 日之備份。它使用 Linux 的 find mtime 指令來決定備份是否超過 X 日。"

msgid "Message"
msgstr "訊息"

msgid "Method"
msgstr "方式"

msgid "Password"
msgstr "密碼"

msgid "Root device"
msgstr "根裝置"

msgid "Schedule"
msgstr "預定工作"

msgid "Scheduled Backup"
msgstr "預定備份"

msgid "Settings"
msgstr "設定"

msgid "Shared folder"
msgstr "共享檔案夾"

msgid "Show more output when checked."
msgstr "當此項被勾選，會顯示較多的輸出。"

msgid "Starting backup ..."
msgstr "開始備份 ..."

msgid "The field should only contain * or a comma separated list of values."
msgstr "此欄位應該只含有 * 或一份以逗號分隔的數值列表。"

msgid "The location of the backup files."
msgstr "備份檔案的位置。"

msgid ""
"To exclude addition directories, add --exclude= before each directory and "
"separate additional entries with a space. Example<br />--exclude=/pool "
"--exclude=/test<br />Warning!!  You can break the backup with wrong options."
msgstr "若要摒除額外的檔案目錄，則在每個檔案目錄前加上 --exclude=，並已空格分開額外的目錄。例如：<br />--exclude=/pool --exclude=/test<br />警告 !! 用錯選項會造成備份作業錯誤。"

msgid "Updated backup settings."
msgstr "已儲存備份設定。"

msgid "Verbose output"
msgstr "詳細輸出"

msgid "borgbackup"
msgstr "borgbackup"

msgid "dd"
msgstr "dd"

msgid ""
"dd - use dd to clone the OS partition to a compressed image file.<br />dd "
"full disk - use dd to clone the entire drive to a compressed image file.<br "
"/>fsarchiver - use fsarchiver to clone the OS partition to an archive "
"file<br />borgbackup - use borgbackup to backup system to an archive file<br"
" />rsync - use rsync to sync files to destination directory"
msgstr "dd - 使用 dd 來複製 OS 分割區到一個壓縮過之映像檔案。<br />dd full disk - 使用 dd 來複製整個驅動碟到一個壓縮過之映像檔案。<br />fsarchiver - 使用 fsarchiver 來複製 OS 分割區到一個存檔檔案。<br />borgbackup - 使用 borgbackup 來備份系統到一個存檔檔案。<br />rsync - 使用 rsync 來將檔案同步至目標檔案目錄。"

msgid "dd full disk"
msgstr "dd 完整磁碟"

msgid "fsarchiver"
msgstr "fsarchiver"

msgid "rsync"
msgstr "rsync"
